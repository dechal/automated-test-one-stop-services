# Tool versions - single source of truth shared by setup-windows.bat and
# setup-linux.sh. Format: KEY=value, one per line, no spaces around '='.
# Lines starting with '#' are comments (skipped by both parsers).
# 
# Node runtime authority is the Volta pin in package.json ("volta".node).
# Keep NODE_VERSION below in sync with that pin.
# Node 26 = Current (LTS Oct 2027). Moved off 25 (odd release, now end-of-life).
NODE_VERSION=26.9.0
PYTHON_VERSION=3.14
# pnpm authority is the Volta pin in package.json ("volta".pnpm). Keep in sync.
# The MAJOR of these two doubles as the minimum accepted version of an
# already-installed node/pnpm: below it, the setup scripts install the pinned
# version instead of skipping, because pnpm-lock.yaml (lockfileVersion 9) and the
# Hub build both fail in confusing ways on an older toolchain.
PNPM_VERSION=11.23.0
