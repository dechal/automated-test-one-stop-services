{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.14",
  "typeCheckingMode": "standard",
  "useLibraryCodeForTypes": true,
  "reportMissingImports": "warning",
  "reportMissingModuleSource": "warning",
  "reportAttributeAccessIssue": "error",
  "reportUnnecessaryTypeIgnoreComment": "warning",
  "reportUnnecessaryComparison": "warning",
  "reportCallIssue": "error",
  "reportArgumentType": "error",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/generated",
    "**/outputs",
    "**/results",
    "**/reports",
    "**/logs",
    "**/dist",
    "**/.git",
    "**/.kiro",
    "**/.cache"
  ],
  "executionEnvironments": [
    {
      "root": "tools/pywinauto",
      "extraPaths": [
        "tools/pywinauto/resources",
        "tools/pywinauto/.venv/Lib/site-packages"
      ]
    },
    {
      "root": "tools/robot-framework",
      "extraPaths": [
        "tools/robot-framework/resources",
        "tools/robot-framework/.venv/Lib/site-packages"
      ]
    },
    {
      "root": "."
    }
  ]
}
